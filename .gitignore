# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env files
.env
.env.*
!.env.example

# OS-specific
.DS_Store

# Editor / IDEs
.idea/
.vscode/
*.swp
*.swo

# Build/Temp output
bin/
build/
tmp/
debug
__debug_bin*

# Compiled server binaries
redisgo
server_bin
test-server

# Runtime output: logs, the AOF snapshot and benchmark transcripts are all
# regenerated on every run and should not be versioned.
*.log
*.aof
server_log*.txt
bench/*.txt
bench/results/


